# ============================================
# Configuración MongoDB Atlas
# ============================================

# URI de conexión a MongoDB Atlas
# Formato: mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Obtén tu URI desde MongoDB Atlas -> Database -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://apaoloc:admin123@basesii.7olat.mongodb.net/?retryWrites=true&w=majority&appName=BasesII

# ============================================
# Configuración Groq LLM (API Key)
# ============================================

# Obtén tu API Key gratuita en: https://console.groq.com/keys
# Regístrate, crea una nueva API key y pégala aquí
GROQ_API_KEY=tu_api_key_de_groq_aqui

# ============================================
# Configuración de la Base de Datos
# ============================================

# Nombre de la base de datos (por defecto: agencia_viajes_turisticos)
DB_NAME=agencia_viajes_turisticos

# ============================================
# INSTRUCCIONES DE USO
# ============================================
# 
# 1. Copia este archivo y renómbralo como .env (sin el .example)
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA compartas este archivo .env en repositorios públicos
# 4. Agrega .env a tu .gitignore para mantenerlo privado
#
# ============================================
