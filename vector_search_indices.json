  "query_ejemplo": {
    "descripcion": "Ejemplo de consulta Vector Search en Node.js",
    "codigo": "const results = await db.collection('hotel').aggregate([{ $vectorSearch: { index: 'vector_search_hotel', path: 'embedding', queryVector: userQueryEmbedding, numCandidates: 100, limit: 10, filter: { categoria: { $gte: 4 } } } }]).toArray();"
