  "instrucciones_detalladas": {
    "paso_1": "Ve a MongoDB Atlas: https://cloud.mongodb.com",
    "paso_2": "Selecciona tu cluster > Database > pestaña 'Atlas Search'",
    "paso_3": "Click en 'CREATE SEARCH INDEX'",
    "paso_4": "Selecciona 'Atlas Vector Search - JSON Editor'",
    "paso_5": "Selecciona tu base de datos y la colección correspondiente",
    "paso_6": "Copia el JSON completo del campo 'json' de cada entidad",
    "paso_7": "Pega en el editor JSON",
    "paso_8": "Usa el 'index_name' sugerido o personaliza",
    "paso_9": "Click 'Create Search Index'",
    "paso_10": "Espera a que el índice se construya (status: Active)"
  },

  "notas_importantes": {
    "dimensiones": "Los vectores están configurados para 1536 dimensiones (OpenAI text-embedding-ada-002). Ajusta 'numDimensions' según tu modelo de embeddings.",
    "similarity": "Usa 'cosine' para similitud semántica. Otras opciones: 'euclidean', 'dotProduct'",
    "filtros": "Los campos 'filter' permiten pre-filtrar resultados antes de la búsqueda vectorial",
    "campo_embedding": "Debes agregar un campo 'embedding' (array de números) a tus documentos antes de usar Vector Search",
    "generacion_embeddings": "Usa OpenAI API, Hugging Face, o Cohere para generar embeddings de campos de texto (nombre, descripcion, etc.)"
  },

